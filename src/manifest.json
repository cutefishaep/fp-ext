{
  "manifest_version": 3,
  "name": "Fish Acceleration",
  "version": "1.13",
  "description": "Desktop UA, Material 3 Dark theme & 1:1 Ingest Bypass for TikTok Studio.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Fish Acceleration"
  },
  "permissions": [
    "declarativeNetRequest",
    "storage",
    "tabs",
    "scripting",
    "offscreen",
    "userScripts"
  ],
  "host_permissions": [
    "*://*.tiktok.com/*",
    "*://*.tiktokcdn.com/*",
    "*://*.tiktokcdn-us.com/*",
    "*://*.tiktokcdn-eu.com/*",
    "*://*.tiktokv.com/*",
    "*://*.byteoversea.com/*",
    "*://*.akamaized.net/*",
    "*://*.tikwm.com/*",
    "*://*.cutefish.my.id/*",
    "https://api.github.com/*",
    "https://github.com/*",
    "https://objects.githubusercontent.com/*",
    "https://release-assets.githubusercontent.com/*",
    "https://cdn.jsdelivr.net/*",
    "https://unpkg.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "background": {
    "service_worker": "background.js"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_ua",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.tiktok.com/tiktokstudio*",
        "*://*.tiktok.com/tiktokstudio",
        "*://*.tiktok.com/upload*"
      ],
      "js": ["isolated.js"],
      "world": "ISOLATED",
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.tiktok.com/tiktokstudio*",
        "*://*.tiktok.com/tiktokstudio",
        "*://*.tiktok.com/upload*"
      ],
      "css": ["boot-dark.css"],
      "run_at": "document_start"
    }
  ]
}
