{
  "manifest_version": 2,
  "name": "Fish Acceleration Canary (MV2)",
  "version": "1.1",
  "description": "Canary Manifest V2 build — Desktop UA, Material 3 Dark theme, Live Core Auto-Updater & FFmpeg WASM Compress for TikTok Studio.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "Fish Acceleration Canary"
  },
  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "storage",
    "tabs",
    "*://*.tiktok.com/*",
    "*://*.tiktokcdn.com/*",
    "*://*.tiktokcdn-us.com/*",
    "*://*.akamaized.net/*",
    "*://*.tikwm.com/*",
    "https://api.github.com/*",
    "https://github.com/*",
    "https://objects.githubusercontent.com/*",
    "https://release-assets.githubusercontent.com/*",
    "https://cdn.jsdelivr.net/*",
    "https://unpkg.com/*"
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },
  "content_security_policy": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'",
  "content_scripts": [
    {
      "matches": [
        "*://*.tiktok.com/tiktokstudio*",
        "*://*.tiktok.com/tiktokstudio",
        "*://*.tiktok.com/upload*"
      ],
      "css": ["boot-dark.css"],
      "js": ["main-bridge.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    "updater.html",
    "content.js",
    "isolated.js",
    "content.css",
    "core-version.json",
    "core-config.json",
    "icons/*"
  ]
}
