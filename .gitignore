# Ignore all files and directories by default
/*

# Whitelist asset/ and all contents
!/asset/
!/asset/**

# Whitelist source + build tooling + docs
!/src/
!/src/**
!/build.mjs
!/README.md

# Generated zips stay out of git (downloadable from GitHub Releases)
!/build/
!/build/**
build/*.zip

# Whitelist .gitignore
!.gitignore
